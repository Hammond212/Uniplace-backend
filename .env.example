# Server
PORT=5000
NODE_ENV=development

# JWT Secret - CHANGE THIS to a long random string in production!
JWT_SECRET=uniplace_super_secret_key_change_me_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# Max file upload size (in bytes) - 5MB
MAX_FILE_SIZE=5242880

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://hammond212.github.io
